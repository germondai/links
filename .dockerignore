# version control
.git
.gitignore

# deps (reinstalled inside the image)
node_modules

# next build output (rebuilt inside the image)
.next
out

# local env - never bake secrets into the image
.env
.env.*
!.env.example

# dev / test artefacts
coverage
*.tsbuildinfo
next-env.d.ts

# editor & OS noise
.DS_Store
*.pem
.vscode
.idea

# CI / deploy configs not needed at runtime
.github
netlify.toml
vercel.json
